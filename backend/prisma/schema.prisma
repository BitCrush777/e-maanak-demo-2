// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================================
// ENUMS
// ================================================================

enum Role {
  OWNER
  OFFICER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InstrumentStatus {
  REGISTERED
  PENDING_VERIFICATION
  VERIFIED
  FAILED
  RETIRED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  INSPECTION_IN_PROGRESS
  INSPECTION_COMPLETED
  CERTIFICATE_ISSUED
  REJECTED
}

enum InspectionResult {
  PASS
  FAIL
  PENDING
}

enum CertificateStatus {
  VALID
  EXPIRED
  REVOKED
  INVALID
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_ASSIGNED
  INSPECTION_COMPLETED
  CERTIFICATE_ISSUED
  CERTIFICATE_EXPIRING
  CERTIFICATE_EXPIRED
  CERTIFICATE_REVOKED
  SYSTEM_ALERT
}

enum AuditAction {
  LOGIN
  LOGOUT
  INSTRUMENT_CREATED
  INSTRUMENT_UPDATED
  APPLICATION_CREATED
  APPLICATION_UPDATED
  INSPECTION_CREATED
  INSPECTION_UPDATED
  CERTIFICATE_CREATED
  CERTIFICATE_REVOKED
  USER_CREATED
  USER_UPDATED
  RULE_CREATED
  RULE_UPDATED
  ADMIN_ACTION
}

// ================================================================
// MODELS
// ================================================================

model User {
  id               String    @id @default(uuid())
  supabaseAuthId   String    @unique
  email            String    @unique
  fullName         String
  role             Role      @default(OWNER)
  status           UserStatus @default(ACTIVE)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  instruments      Instrument[]
  applications     VerificationApplication[]
  inspections      VerificationInspection[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  revokedCertificates Certificate[] @relation("RevokedBy")

  @@index([supabaseAuthId])
  @@index([email])
  @@index([role])
}

model InstrumentTypeRule {
  id              String   @id @default(uuid())
  instrumentType  String
  ruleCode        String   @unique
  ruleVersion     String
  description     String?
  isActive        Boolean  @default(true)
  effectiveDate   DateTime @default(now())
  toleranceConfig Json     // { absoluteTolerance: Decimal, percentageTolerance: Decimal }
  testPointSchedule Json   // [20, 50, 100] or custom schedule
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  inspections     VerificationInspection[]

  @@index([instrumentType])
  @@index([ruleCode])
  @@index([isActive])
}

model Instrument {
  id                 String           @id @default(uuid())
  ownerId            String
  type               String
  manufacturer       String
  model              String
  serialNumber       String
  ratedCapacity      String?
  verificationInterval Int            @default(12) // months
  status             InstrumentStatus @default(REGISTERED)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applications     VerificationApplication[]
  certificates     Certificate[]

  @@index([ownerId])
  @@index([serialNumber])
  @@index([type])
  @@index([status])
  @@unique([ownerId, serialNumber])
}

model VerificationApplication {
  id                String            @id @default(uuid())
  instrumentId      String
  applicantId       String
  status            ApplicationStatus @default(DRAFT)
  assignedOfficerId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  instrument   Instrument   @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  applicant    User         @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)
  assignedOfficer User?     @relation(fields: [assignedOfficerId], references: [id])
  inspection    VerificationInspection?

  @@index([instrumentId])
  @@index([applicantId])
  @@index([status])
  @@index([assignedOfficerId])
}

model VerificationInspection {
  id                String           @id @default(uuid())
  applicationId     String           @unique
  officerId         String
  ruleId            String
  result            InspectionResult @default(PENDING)
  clientOperationId String?          @unique // For idempotent sync
  notes             String?
  performedAt       DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  application VerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  officer     User                    @relation(fields: [officerId], references: [id])
  rule        InstrumentTypeRule      @relation(fields: [ruleId], references: [id])
  readings    VerificationReading[]
  certificate Certificate?

  @@index([applicationId])
  @@index([officerId])
  @@index([result])
  @@index([clientOperationId])
}

model VerificationReading {
  id              String  @id @default(uuid())
  inspectionId    String
  pointName       String
  referenceLoad   Decimal @db.Decimal(15, 4)
  observedValue   Decimal @db.Decimal(15, 4)
  error           Decimal @db.Decimal(15, 4)
  percentageError Decimal @db.Decimal(15, 4)
  result          InspectionResult
  createdAt       DateTime @default(now())

  // Relations
  inspection VerificationInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model Certificate {
  id                    String           @id @default(uuid())
  certificateNumber     String           @unique
  verificationInspectionId String        @unique
  qrToken               String           @unique
  issueDate             DateTime         @default(now())
  expiryDate            DateTime
  status                CertificateStatus @default(VALID)
  revokedAt             DateTime?
  revocationReason      String?
  revokedById           String?
  createdAt             DateTime         @default(now())

  // Relations
  verificationInspection VerificationInspection @relation(fields: [verificationInspectionId], references: [id])
  instrument            Instrument              @relation(fields: [verificationInspectionId], references: [id])
  revokedBy             User?                   @relation("RevokedBy", fields: [revokedById], references: [id])

  @@index([certificateNumber])
  @@index([qrToken])
  @@index([status])
  @@index([expiryDate])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  action      AuditAction
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model FederationLog {
  id            String   @id @default(uuid())
  federationType String
  operation     String
  payload       Json
  status        String
  response      Json?
  createdAt     DateTime @default(now())

  @@index([federationType])
  @@index([status])
}

